{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeonTranslatorDX Manager",
  "mainBinaryName": "NeonTranslatorDXManager",
  "version": "2026.11.26-1",
  "identifier": "com.domovikx.neontranslatordx-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NeonTranslatorDX Manager",
        "width": 940,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../payload/": "payload/"
    }
  }
}
