/**
 * script_guard.mts — чужая письменность внутри перевода.
 *
 * Симптом: русское слово собрано из букв разных алфавитов — модель подставляет
 * визуально похожий символ. В ru так испортилось имя героя: `Lio` стал `Лิโอ`
 * (тайский) и `Лيو` (арабский) в 13 строках, ещё `Пrying` (кириллица + латиница).
 * В игре это кракозябры, а глазами такую строку почти невозможно заметить:
 * символы выглядят как обычные буквы (проверено 2026-11-23).
 *
 * Поэтому проверка механическая: любой символ, который не кириллица, не
 * латиница, не цифра, не пунктуация, не пробел/символ — дефект (переносы строк
 * и табуляция разрешены отдельно: это `\s`, а не буква). Марки
 * (диакритика) разрешены: они бывают в сочетаниях.
 */

/** Символы, допустимые в переводе (кириллица, латиница, цифры, пунктуация, пробелы, символы, марки). */
const ALLOWED_RX = /[\p{Script=Cyrillic}\p{Script=Latin}\p{N}\p{P}\p{Z}\p{S}\p{M}\s]/u;

/**
 * Найти символы чужой письменности.
 *
 * Возвращает уникальные символы в порядке появления (для отчёта). Пусто —
 * письменность чистая.
 */
export function foreignScriptHits(text: string): string[] {
  const found: string[] = [];
  for (const ch of text) {
    if (!ALLOWED_RX.test(ch) && !found.includes(ch)) found.push(ch);
  }
  return found;
}

/**
 * Языки, чья письменность — кириллица или латиница.
 *
 * Только для них «чужая письменность» = дефект. Для zh/ja/ko проверка
 * бессмысленна: весь перевод из иероглифов.
 */
export const LATIN_CYRILLIC_LANGS: ReadonlySet<string> = new Set([
  "en",
  "ru",
  "de",
  "es",
  "fr",
  "it",
  "pl",
  "pt",
]);

/** Есть ли в тексте хоть один символ чужой письменности. */
export function hasForeignScript(text: string): boolean {
  for (const ch of text) if (!ALLOWED_RX.test(ch)) return true;
  return false;
}
