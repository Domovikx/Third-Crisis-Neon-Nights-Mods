/**
 * register_lexicon.mts — механическая проверка регистра 18+ в переводе.
 *
 * Почему механикой: LLM-судья ненадёжен именно в регистре. На прогоне
 * 2026-11-23 (index-translate-9b) он флагнул «register-clinical» на стонах
 * («Не может-.. Быть так-.. Хорошо-..») и «register-soft» на нормальной
 * наррации — то есть мерил ощущение, а не факт. Лексикон даёт проверяемый
 * ответ: какое слово клиническое, какое откровенное.
 *
 * Лексикон перенесён из TSSR (`tone_lexicon.mts`, проверен практикой):
 * - клинические термины «по корню» (языки флективные: «влагалищ» покрывает
 *   влагалище/влагалища/влагалищем);
 * - у коротких корней границы слова, иначе «анус» ловится внутри «останусь»;
 * - `weak` — слово нормальное для жанра (клитор, матка, влагалище после
 *   решения владельца 2026-11-13), само по себе не дефект.
 *
 * Второй слой — «смягчение»: оригинал откровенен, перевод откровенных слов не
 * содержит. Это кандидат на вычитку, а не приговор: перевод может быть
 * эвфемизмом по смыслу сцены.
 */

/** Один клинический термин: имя для отчёта + шаблон поиска. */
export interface ClinicalTerm {
  name: string;
  re: RegExp;
  /** Слово нормальное для жанра: само по себе не дефект. */
  weak?: boolean;
}

