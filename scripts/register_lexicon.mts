/**
 * Строки, где оригинал откровеннее перевода.
 *
 * Возвращает имена потерянных терминов. Пусто — откровенность сохранена или
 * в оригинале её не было. Совпадение по корню, не по точной форме: русский
 * перевод почти всегда меняет падеж.
 */
export function softenedHits(
  source: string,
  translation: string,
  terms: ExplicitTerm[] = EXPLICIT_RU,
): string[] {
  return terms.filter((t) => t.en.test(source) && !t.ru.test(translation)).map((t) => t.name);
}
