/**
 * register_lexicon.mts — механическая проверка регистра 18+ в переводе.
 *
 * Почему механикой: LLM-судья ненадёжен именно в регистре. На прогоне
 * 2026-11-23 (index-translate-9b) он флагнул «register-clinical» на стонах
 * («Не может-.. Быть так-.. Хорошо-..») и «register-soft» на нормальной
 * наррации — то есть мерил ощущение, а не факт. Лексикон даёт проверяемый
 * ответ: какое слово клиническое, какое откровенное.
 *
 * Лексикон перенесён из TSSR (`tone_lexicon.mts`, проверен практикой):
 * - клинические термины «по корню» (языки флективные: «влагалищ» покрывает
 *   влагалище/влагалища/влагалищем);
 * - у коротких корней границы слова, иначе «анус» ловится внутри «останусь»;
 * - `weak` — слово нормальное для жанра (клитор, матка, влагалище после
 *   решения владельца 2026-11-13), само по себе не дефект.
 *
 * Второй слой — «смягчение»: оригинал откровенен, перевод откровенных слов не
 * содержит. Это кандидат на вычитку, а не приговор: перевод может быть
 * эвфемизмом по смыслу сцены.
 */

/** Один клинический термин: имя для отчёта + шаблон поиска. */
export interface ClinicalTerm {
  name: string;
  re: RegExp;
  /** Слово нормальное для жанра: само по себе не дефект. */
  weak?: boolean;
}

/** Клинический регистр для ru (TSSR-лексикон, проверен на корпусе). */
export const CLINICAL_RU: ClinicalTerm[] = [
  {
    name: "половые органы",
    re: /(?<![\p{L}])полов(?:ые|ых|ым|ыми|ой|ого|ому|ая|ое)\s+(?:орган|губ)/iu,
  },
  {
    name: "половой акт",
    re: /(?<![\p{L}])полов(?:ой|ым|ого|ые|ых|ая|ое)\s+(?:акт|сношени|связ|жизн|член|возбуждени)/iu,
  },
  { name: "влагалище", re: /(?<![\p{L}])влагалищ/iu, weak: true },
  { name: "вагина", re: /(?<![\p{L}])вагин/iu },
  { name: "пенис", re: /(?<![\p{L}])пенис/iu },
  { name: "эрекция", re: /(?<![\p{L}])эрекц/iu, weak: true },
  { name: "эякуляция", re: /(?<![\p{L}])эякуля/iu },
  { name: "семяизвержение", re: /(?<![\p{L}])семяизвержени/iu },
  { name: "копуляция", re: /(?<![\p{L}])копуляц/iu },
  { name: "совокупление", re: /(?<![\p{L}])совокуплени/iu },
  { name: "мастурбация", re: /(?<![\p{L}])мастурбац/iu, weak: true },
  { name: "онанизм", re: /(?<![\p{L}])онанизм/iu },
  {
    name: "анус",
    re: /(?<![\p{L}])анус(?:а|у|ом|е|ы|ов|ам|ами|ах)?(?![\p{L}])/iu,
    weak: true,
  },
  { name: "задний проход", re: /(?<![\p{L}])задн(?:ий|его|ему|им|ем)\s+проход/iu },
  { name: "прямая кишка", re: /(?<![\p{L}])прям(?:ая|ой|ую)\s+кишк/iu },
  { name: "промежность", re: /(?<![\p{L}])промежност/iu, weak: true },
  { name: "гениталии", re: /(?<![\p{L}])генитал/iu },
  { name: "мошонка", re: /(?<![\p{L}])мошонк/iu },
  {
    name: "оральный секс",
    re: /(?<![\p{L}])оральн(?:ый|ого|ым|ом|ая|ой|ую|ые|ых)\s+секс(?:а|у|ом|е)?(?![\p{L}])/iu,
  },
  {
    name: "анальный секс",
    re: /(?<![\p{L}])анальн(?:ый|ого|ым|ом|ая|ой|ую|ые|ых)\s+секс(?:а|у|ом|е)?(?![\p{L}])/iu,
  },
  { name: "клитор", re: /(?<![\p{L}])клитор/iu, weak: true },
  { name: "матка", re: /(?<![\p{L}])матк(?:а|и|у|ой|е|ам|ами|ах)(?![\p{L}])/iu, weak: true },
  { name: "лобок", re: /(?<![\p{L}])лоб(?:ок|ка|ком|ке)(?![\p{L}])/iu, weak: true },
];

/** Что считается клиничным в переводе. Пустой список — регистр чист. */
export function clinicalHits(text: string, terms: ClinicalTerm[] = CLINICAL_RU): string[] {
  return terms.filter((t) => !t.weak && t.re.test(text)).map((t) => t.name);
}

/**
 * Откровенный английский термин → чем он может быть в русском.
 *
 * Задача не «требовать конкретное слово», а поймать ПОТЕРЮ откровенности:
 * если в оригинале `cock`, а в переводе нет ни одного откровенного
 * соответствия — строку надо посмотреть глазами. Синонимы из списка равны
 * между собой (решение владельца 2026-11-13: «хуй», «член», «хер» — все
 * допустимы; клиника — «половой член», «пенис» в диалоге).
 */
