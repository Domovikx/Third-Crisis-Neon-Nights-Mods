{
  "name": "third-crisis-neon-nights-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Локализация Third Crisis: Neon Nights — TS-пайплайн (dump → POT/PO → DAT) + C# рантайм scan-and-replace",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:game": "node scripts/game_dir.mts --check",
    "check:langs": "node scripts/languages.mts --check",
    "kaizen": "node ../indie-ops/skills/kaizen/kaizen_check.mts --root .opencode/skills",
    "build:site": "node scripts/build_site.mts",
    "mod:install": "node installer/install.mts",
    "potgen": "node scripts/text_cli.mts potgen",
    "po2dat": "node scripts/text_cli.mts po2dat",
    "po:update": "node scripts/text_cli.mts po_update",
    "po:prefill": "node scripts/text_cli.mts prefill",
    "find:source": "node scripts/text_cli.mts find_source",
    "qa": "node scripts/qa.mts",
    "qa:review": "node .opencode/skills/translate-qa/scripts/review_queue.mts",
    "translate:local": "node .opencode/skills/translate-local/scripts/translate_local.mts",
    "test:qa": "node --test .opencode/skills/translate-qa/tests/qa_translate.test.mts .opencode/skills/translate-qa/tests/review_queue.test.mts .opencode/skills/translate-local/tests/translate_local.test.mts scripts/qa_parity.test.mts",
    "test": "node --test .opencode/skills/pipeline-common/tests/text_filters.test.mts .opencode/skills/extract-text/tests/po_file.test.mts .opencode/skills/extract-text/tests/inventory.test.mts .opencode/skills/extract-text/tests/rich_audit.test.mts .opencode/skills/extract-text/tests/potgen.test.mts .opencode/skills/extract-text/tests/po_update.test.mts scripts/languages.test.mts .opencode/skills/build-translator/tests/build.test.mts .opencode/skills/deploy-translator/tests/deploy.test.mts scripts/game_version.test.mts .opencode/skills/dump-assets/tests/unityfs.test.mts .opencode/skills/dump-assets/tests/serialized.test.mts .opencode/skills/dump-assets/tests/lz4.test.mts .opencode/skills/dump-assets/tests/lzma.test.mts .opencode/skills/dump-assets/tests/binary.test.mts scripts/package_release.test.mts scripts/text_parity.test.mts scripts/rich_roundtrip.test.mts scripts/text_golden.test.mts scripts/rich_pass.test.mts scripts/rt_audit.test.mts scripts/pot_invariants.test.mts scripts/fragment_repair.test.mts .opencode/skills/extract-text/tests/pot_contract.test.mts scripts/no_python.test.mts",
    "test:e2e": "node --test .opencode/skills/extract-text/tests/pipeline.e2e.test.mts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:langs && npm test && npm run test:dump && npm run test:qa && npm run test:e2e",
    "build": "node .opencode/skills/build-translator/scripts/build.mts",
    "build:proxy": "node .opencode/skills/build-translator/scripts/build_proxy.mts",
    "deploy": "node .opencode/skills/deploy-translator/scripts/deploy.mts",
    "check:version": "node scripts/game_version.mts",
    "dump:structure": "node .opencode/skills/dump-assets/scripts/dump_assets.mts structure --all",
    "dump:parity": "node scripts/dump_parity.mts",
    "test:dump": "node --test .opencode/skills/dump-assets/tests/*.test.mts",
    "release": "node scripts/package_release.mts",
    "rust:build": "cargo build --release --manifest-path tools/rust-decoder/Cargo.toml",
    "rust:test": "cargo test --manifest-path tools/rust-decoder/Cargo.toml",
    "dump:rust": "node .opencode/skills/dump-assets/scripts/dump_assets.mts dump --decoder rust",
    "bench:dump": "node scripts/dump_bench.mts --runs 2",
    "dump": "node .opencode/skills/dump-assets/scripts/dump_assets.mts dump --decoder rust",
    "dump:ts": "node .opencode/skills/dump-assets/scripts/dump_assets.mts dump --decoder ts",
    "qa:ts": "node .opencode/skills/translate-qa/scripts/qa_translate.mts",
    "qa:build": "cargo build --release --manifest-path tools/rust-qa/Cargo.toml",
    "qa:bench": "node scripts/qa_scaling_bench.mts --scales 1,10,100 --runs 2",
    "l10n:build": "cargo build --release --manifest-path tools/rust-l10n/Cargo.toml",
    "potgen:ts": "node .opencode/skills/extract-text/scripts/potgen.mts",
    "rust:lint:build": "cargo build --release --manifest-path tools/rust-lint/Cargo.toml",
    "test:rust:lint": "cargo test --manifest-path tools/rust-lint/Cargo.toml",
    "lint:data": "cargo run --release --quiet --manifest-path tools/rust-lint/Cargo.toml -- --root . --json-dir tmp --report tmp/lint-report.md",
    "pot:check": "node scripts/pot_invariants.mts po/template.pot",
    "pot:check:full": "node scripts/pot_invariants.mts po/template.pot --dump tmp/dump-new",
    "po:update:ts": "node .opencode/skills/extract-text/scripts/po_update.mts",
    "test:golden": "node --test scripts/text_golden.test.mts",
    "rich:audit": "node .opencode/skills/extract-text/scripts/rich_audit.mts",
    "dash": "node .opencode/skills/local-dash/dashboard.mts",
    "rt:audit": "node scripts/rt_audit.mts",
    "rt:pass": "node scripts/rich_pass.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
