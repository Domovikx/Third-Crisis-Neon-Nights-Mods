{
  "name": "third-crisis-neon-nights-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Локализация Third Crisis: Neon Nights — TS-пайплайн (dump → POT/PO → DAT) + C# рантайм scan-and-replace",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:game": "node scripts/game_dir.mts --check",
    "check:langs": "node scripts/languages.mts --check",
    "kaizen": "node ../indie-ops/skills/kaizen/kaizen_check.mts --root .opencode/skills",
    "build:site": "node scripts/build_site.mts",
    "mod:install": "node installer/install.mts",
    "potgen": "node .opencode/skills/extract-text/scripts/potgen.mts",
    "po2dat": "node .opencode/skills/extract-text/scripts/po2dat.mts",
    "po:update": "node .opencode/skills/extract-text/scripts/po_update.mts",
    "po:prefill": "node .opencode/skills/extract-text/scripts/prefill_po.mts",
    "find:source": "node .opencode/skills/extract-text/scripts/find_source.mts",
    "qa": "node .opencode/skills/translate-qa/scripts/qa_translate.mts",
    "qa:review": "node .opencode/skills/translate-qa/scripts/review_queue.mts",
    "translate:local": "node .opencode/skills/translate-local/scripts/translate_local.mts",
    "test:qa": "node --test .opencode/skills/translate-qa/tests/qa_translate.test.mts .opencode/skills/translate-qa/tests/review_queue.test.mts .opencode/skills/translate-local/tests/translate_local.test.mts",
    "test": "node --test .opencode/skills/pipeline-common/tests/text_filters.test.mts .opencode/skills/extract-text/tests/po_file.test.mts .opencode/skills/extract-text/tests/po2dat.test.mts .opencode/skills/extract-text/tests/inventory.test.mts .opencode/skills/extract-text/tests/potgen.test.mts .opencode/skills/extract-text/tests/po_update.test.mts .opencode/skills/extract-text/tests/prefill_po.test.mts .opencode/skills/extract-text/tests/find_source.test.mts scripts/languages.test.mts .opencode/skills/build-translator/tests/build.test.mts .opencode/skills/deploy-translator/tests/deploy.test.mts scripts/game_version.test.mts .opencode/skills/dump-assets/tests/unityfs.test.mts .opencode/skills/dump-assets/tests/serialized.test.mts .opencode/skills/dump-assets/tests/lz4.test.mts .opencode/skills/dump-assets/tests/lzma.test.mts .opencode/skills/dump-assets/tests/binary.test.mts scripts/package_release.test.mts",
    "test:e2e": "node --test .opencode/skills/extract-text/tests/pipeline.e2e.test.mts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:langs && npm test && npm run test:dump && npm run test:qa && npm run test:e2e",
    "build": "node .opencode/skills/build-translator/scripts/build.mts",
    "build:proxy": "node .opencode/skills/build-translator/scripts/build_proxy.mts",
    "deploy": "node .opencode/skills/deploy-translator/scripts/deploy.mts",
    "check:version": "node scripts/game_version.mts",
    "dump:structure": "node .opencode/skills/dump-assets/scripts/dump_assets.mts structure --all",
    "dump:parity": "node scripts/dump_parity.mts",
    "test:dump": "node --test .opencode/skills/dump-assets/tests/*.test.mts",
    "release": "node scripts/package_release.mts",
    "rust:build": "cargo build --release --manifest-path tools/rust-decoder/Cargo.toml",
    "rust:test": "cargo test --manifest-path tools/rust-decoder/Cargo.toml",
    "dump:rust": "node .opencode/skills/dump-assets/scripts/dump_assets.mts dump --decoder rust",
    "bench:dump": "node scripts/dump_bench.mts --runs 2",
    "dump": "node .opencode/skills/dump-assets/scripts/dump_assets.mts dump --decoder rust",
    "dump:ts": "node .opencode/skills/dump-assets/scripts/dump_assets.mts dump --decoder ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
