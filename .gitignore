# Репозиторий — только инструменты и переводы. Игра лежит отдельно и не трекается.

# Зависимости
node_modules/

# Временное (одна тема = одна подпапка, см. AGENTS.md)
tmp/

# Артефакты сборки
output/
runtime/*.dat
runtime/*.dll
*.obj
*.lib
*.exp
*.exe

# Сайт собирается из site/template.html (в CI перед Pages, локально — npm run build:site)
site/index.html
site/en.html

# Python-остров (dump-assets/UnityPy) — кэши
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Деплой-мусор
.install_temp/

# ОС
nul
Thumbs.db
.DS_Store

# Прокси (артефакт сборки build:proxy), в корне репозитория не трекается
dwmapi.dll
dwmapi_real.dll

# Rust (tools/rust-decoder)
target/

# Релизные архивы
dist/

# Бэкапы po_update (*.bak) — локальные, в git не нужны
po/*.bak
# демо озвучки: аудио и референсы живут локально
voice-demo/
