msgctxt "ui"
msgid "A-_?T"
msgstr ""

msgctxt "ui"
msgid "A-_?\\d"
msgstr ""

msgctxt "ui"
msgid "A-about that..."
msgstr ""

#. rich_text: <color=#EB83FF>A-and besides, I-... I don't... I-...</color>
msgctxt "speaker:Zoey"
msgid "A-and besides, I-... I don't... I-..."
msgstr ""

#. rich_text: <color=#EB83FF>A-and n-no touching...!</color>
msgctxt "speaker:Zoey"
msgid "A-and n-no touching...!"
msgstr ""

msgctxt "speaker:Mira"
msgid "A-another strawberry...? Would that be- um- like... okay...?"
msgstr ""

msgctxt "ui"
msgid "A-are you okay, Cypher... ?"
msgstr ""

#. rich_text: <color=#EB83FF>A-at what...?</color>
