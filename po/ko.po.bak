msgctxt "speaker:Mira"
msgid "A-... Hhh... Go with you-... to like... a r-room...?"
msgstr ""

#. rich_text: <color=#EB83FF>A-... a quick peek. Nothing else... Understood?</color>
msgctxt "ui"
msgid "A-... a quick peek. Nothing else... Understood?"
msgstr ""

#. rich_text: <color=#EB83FF>A-... pleasure...?</color>
msgctxt "ui"
msgid "A-... pleasure...?"
msgstr ""

msgctxt "ui"
msgid "A-A"
msgstr ""

msgctxt "ui"
msgid "A-Ah! I'm not a skank! Let me go!"
msgstr ""

msgctxt "ui"
msgid "A-Ah. I uhm- I mean- I guess we could-"
msgstr ""

msgctxt "ui"
msgid "A-Are you ready for the device, Cypher?"
msgstr ""

msgctxt "ui"
msgid "A-Arf! Arf arf arf!"
msgstr ""

msgctxt "speaker:Zoey"
msgid "A-Arf... Arf..."
msgstr ""

#. rich_text: <color=#EB83FF>A-Arff... Rrrarf~!</color>
