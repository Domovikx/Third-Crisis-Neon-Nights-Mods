msgid "I-... Khh... D-don't do anything stupid...!"
msgstr "Я-... Кх... Н-не делай глупостей...!"

msgctxt "speaker:Zoey"
msgid "I-... N-No... Hhh..."
msgstr "Я-... Н-Нет... Хх..."

