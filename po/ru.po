#. src: dialog
msgctxt "ui"
msgid "Wh- Are you fucking serious?!"
msgstr "Ч- Ты серьёзно, блядь?!"

#. src: dialog
msgctxt "speaker:Lio"
msgid "Wh- Are you serious, Zoey? Wait, was that you that made the commotion at the Redlight District? Fuck, this is not okay!"
msgstr "Ч- Ты серьёзно, Зои? Погоди, это ты устроила тот переполох в Районе Красных Фонарей? Бля, это ни в какие ворота!"

#. src: dialog
msgctxt "ui"
msgid "Wh- But what about your associates?"
msgstr "Н-но... а как же твои партнёры?"

#. src: dialog
msgctxt "ui"
msgid "Wh- Do I look like Vibe? I'm no hero, Sarah. We're talking about GAG here, not to mention the Cartel."
msgstr "Т- Я похожа на Вайб? Я не герой, Сара. Мы говорим о GAG, не говоря уже о Картеле."

#. src: dialog
msgctxt "ui"
msgid "Wh- Like a love potion?"
msgstr "Ч- Вроде приворота?"

#. src: dialog
msgctxt "ui"
msgid "Wh- Really? I mea- You don't have to-"
msgstr "Ч- Правда? Я им- Вы не обязаны-"

#. src: dialog
msgctxt "ui"
msgid "Wh- That's it?"
msgstr "Ч- Это всё?"

#. src: dialog
msgctxt "ui"
msgid "Wh- What have I done...?"
msgstr "Ч- Что я наделала...?"

#. src: dialog
msgctxt "speaker:Zoey"
msgid "Wh- You can't be serious."
msgstr "Ч-... Ты не можешь говорить серьёзно."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh- but-!</color>
msgctxt "speaker:Zoey"
msgid "Wh- but-!"
msgstr "Ч-но... но...!"

#. src: dialog
#. rich_text: <color=#EB83FF>Wh- n-no w-... hhh...!</color>
msgctxt "ui"
msgid "Wh- n-no w-... hhh...!"
msgstr "Ч- н-нет н-... хх...!"

#. src: dialog
#. rich_text: <color=#EB83FF>Wh- wha...?</color>
msgctxt "speaker:Zoey"
msgid "Wh- wha...?"
msgstr "Ч- чё...?"

#. src: dialog
msgctxt "ui"
msgid "Wh- what? No! I-"
msgstr "Ч-что? Нет! Я-"

#. src: dialog
msgctxt "ui"
msgid "Wh- who are you?!"
msgstr "К-кто ты?!"

#. src: dialog
msgctxt "speaker:Zoey"
msgid "Wh-! Hey-!"
msgstr "Ч-! Эй-!"

#. src: dialog
msgctxt "ui"
msgid "Wh-! I mean uh- Heh-"
msgstr "Э-э... То есть... хех..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh-... </color>
msgctxt "ui"
msgid "Wh-..."
msgstr "Ч-..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh-... N-no... I-... </color>
# rich_translation: <color=#EB83FF>Чт-... Н-нет... Я-...</color>
msgctxt "speaker:Zoey"
msgid "Wh-... N-no... I-..."
msgstr "Чт-... Н-нет... Я-..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh-...?! N-no I-... I can't-...!</color>
msgctxt "ui"
msgid "Wh-...?! N-no I-... I can't-...!"
msgstr "Чт-...?! Н-нет, я-... Я не могу-...!"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wha-"
msgstr "Чт..."

#. src: dialog
msgctxt "speaker:Brad"
msgid "Wha- ?"
msgstr "Ч-что? (спикер: Брэд)"

#. src: dialog
msgctxt "speaker:Lio"
msgid "Wha- Really? Shit, Zoey, I wouldn't have made you go through that tunnel if I knew."
msgstr "Ч-что? Серьёзно? Чёрт, Зои, я бы не заставил тебя лезть через тот туннель, если бы знал."

#. src: dialog
#. rich_text: <color=#EB83FF>Wha-... I-...</color>
msgctxt "speaker:Zoey"
msgid "Wha-... I-..."
msgstr "Ч-... Я-..."

