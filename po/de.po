#. src: dialog
msgctxt "speaker:Lio"
msgid "Wha- Really? Shit, Zoey, I wouldn't have made you go through that tunnel if I knew."
msgstr "Wa-wirklich? Scheiße, Zoey, ich hätte dich nicht durch den Tunnel geschickt, wenn ich's gewusst hätte."

#. src: dialog
#. rich_text: <color=#EB83FF>Wha-... I-...</color>
#. rich_translation: <color=#EB83FF>Wa-... ich-...</color>
msgctxt "speaker:Zoey"
msgid "Wha-... I-..."
msgstr "Wa-... ich-..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wha-...! N-no...! That's-... No...!</color>
#. rich_translation: <color=#EB83FF>Wa-...! N-nein...! Das-... nein...!</color>
msgctxt "speaker:Zoey"
msgid "Wha-...! N-no...! That's-... No...!"
msgstr "Wa-...! N-nein...! Das-... nein...!"

#. src: dialog
msgctxt "ui"
msgid "Wha-? But the door was locked!"
msgstr "Wa-? Aber die Tür war abgeschlossen!"

#. src: dialog
msgctxt "ui"
msgid "Wha-?! I never got a cat."
msgstr "Wa-?! Ich hatte nie eine Katze."

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Whaaat!"
