msgid "Wh- n-no w-... hhh...!"
msgstr "W-n-nein w-... hhh...!"

#. src: dialog
#. rich_text: <color=#EB83FF>Wh- wha...?</color>
#. rich_translation: <color=#EB83FF>Wa- was...?</color>
msgctxt "speaker:Zoey"
msgid "Wh- wha...?"
msgstr "Wa- was...?"

#. src: dialog
msgctxt "ui"
msgid "Wh- what? No! I-"
msgstr "W-was? Nein! Ich-"

#. src: dialog
msgctxt "ui"
msgid "Wh- who are you?!"
msgstr "W-wer bist du?!"

#. src: dialog
msgctxt "speaker:Zoey"
msgid "Wh-! Hey-!"
msgstr "W-! Hey-!"

#. src: dialog
msgctxt "ui"
msgid "Wh-! I mean uh- Heh-"
msgstr "W-was?! Also... äh... hehe..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh-... </color>
#. rich_translation: <color=#EB83FF>W-...</color>
msgctxt "ui"
msgid "Wh-..."
msgstr "W-..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh-... N-no... I-... </color>
#. rich_translation: <color=#EB83FF>W-... N-nein... ich-...</color>
msgctxt "speaker:Zoey"
msgid "Wh-... N-no... I-..."
msgstr "W-... N-nein... ich-..."

#. src: dialog
#. rich_text: <color=#EB83FF>Wh-...?! N-no I-... I can't-...!</color>
#. rich_translation: <color=#EB83FF>W-...?! N-nein, ich-... ich kann nicht-...!</color>
msgctxt "ui"
msgid "Wh-...?! N-no I-... I can't-...!"
msgstr "W-...?! N-nein, ich-... ich kann nicht-...!"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wha-"
msgstr "Wa-"

#. src: dialog
msgctxt "speaker:Brad"
msgid "Wha- ?"
