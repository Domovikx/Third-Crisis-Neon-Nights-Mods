msgid "Wet 1 Short"
msgstr "湿的 1 短"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 2"
msgstr "湿润 2"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 3"
msgstr "湿的 3"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 4 Long"
msgstr "湿透 4 漫长"

#. src: us
msgctxt "ui"
msgid "Wet 4 Short"
msgstr "湿的，很短"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 5"
msgstr "湿了5"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 6 Drip"
msgstr "湿漉漉的，六滴"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 7 Squirt"
msgstr "湿润 7 次射精"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 8 Squirt"
msgstr "湿滑 8 次射精"

#. src: raw:MonoBehaviour
msgctxt "ui"
msgid "Wet 9 Thrust"
msgstr "湿润 9 冲击"

#. src: field:DisplayName
msgctxt "ui"
msgid "Wet Pussy"
msgstr "湿润的小穴"

#. src: dialog
msgctxt "ui"
msgid "Wh- Are you fucking serious?!"
msgstr "你——你在开什么玩笑？！"

#. src: dialog
msgctxt "speaker:Lio"
msgid "Wh- Are you serious, Zoey? Wait, was that you that made the commotion at the Redlight District? Fuck, this is not okay!"
msgstr "什——你是认真的吗，佐伊？等等，在红灯区制造骚乱的是你吗？操，这绝对不行！"

#. src: dialog
msgctxt "ui"
msgid "Wh- But what about your associates?"
msgstr "可——可是你的同伴们呢？"

#. src: dialog
msgctxt "ui"
msgid "Wh- Do I look like Vibe? I'm no hero, Sarah. We're talking about GAG here, not to mention the Cartel."
msgstr "我——我看起来像维布吗？我可不是什么英雄，莎拉。我们这儿说的是GAG，更别提还有黑手党呢。"

#. src: dialog
msgctxt "ui"
msgid "Wh- Like a love potion?"
msgstr "什——什么？像是爱情魔药那种吗？"

#. src: dialog
msgctxt "ui"
msgid "Wh- Really? I mea- You don't have to-"
msgstr "什——真的吗？我意思是——你不必——"

#. src: dialog
msgctxt "ui"
msgid "Wh- That's it?"
msgstr "什——就这样？"

#. src: dialog
msgctxt "ui"
msgid "Wh- What have I done...?"
msgstr "我……我到底干了什么……？"

#. src: dialog
msgctxt "speaker:Zoey"
msgid "Wh- You can't be serious."
