msgid "No-! Wait! Please!"
msgstr "Nie...! Czekaj! Proszę!"

#. src: dialog
msgctxt "ui"
msgid "No-.. I-.. I'm quite.. Employed, you know?"
msgstr "Nie... ja... Jestem całkiem... zatrudniona, wiesz?"

#. src: dialog
#. rich_text: <color=#EB83FF>No-... I-... Even if-... Nova would see-... N-not that I would...!</color>
#. rich_translation: <color=#EB83FF>Nie... ja... Nawet gdyby... Nova by zobaczyła... N-nie żebym chciała...!</color>
