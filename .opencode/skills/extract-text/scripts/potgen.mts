/**
 * potgen.mts — сборка `po/template.pot` (EN-шаблон перевода) из дампа ассетов.
 *
 * Порт `extract-text/scripts/potgen.py` в режиме `--update` (функции
 * `build_pot_update` + `render_pot`). Легаси-путь `build_pot()` из YAML
 * (`translations/`) не портируется: дерево удалено, источник истины — дамп.
 *
 * Контракт POT:
 *   - одна запись на уникальную пару (msgid, msgctxt); дубли схлопываются;
 *   - msgctxt: `speaker:<Имя>` / `speaker-name` (имя персонажа) / `ui`;
 *   - `#:` refs НЕ пишутся вовсе (provenance ищется в дампе через find_source);
 *   - `#. rich_text: <разметка>` — исходная TMP-строка с тегами; `<font>` и
 *     `<material>` вырезаются (шрифт выбирает рантайм);
 *   - ui-двойник строки, у которой есть диалоговый/спикерский контекст,
 *     удаляется: рантайм ищет по голому тексту, дубль = двойной перевод;
 *   - записи отсортированы по (msgid, msgctxt) — стабильные диффы переводов.
 *
 * Поведение CLI: без флага `--update` пишет только в `tmp/potgen/`
 * (безопасный прогон), с флагом — обновляет `po/template.pot`.
 */
import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import process from "node:process";

import { isAssetName, isGarbageFragment } from "../../pipeline-common/scripts/text_filters.mts";
import {
  compareCodePoints,
  pyStrip,
  scanDump,
  type InventoryItem,
  type ItemKind,
} from "./inventory.mts";
import { newEntry, parsePo, renderPo, type PoEntry } from "./po_file.mts";

/** Корень репозитория: .../extract-text/scripts → вверх 4 уровня. */
export const REPO_ROOT = resolve(import.meta.dirname, "../../../..");
export const DEFAULT_DUMP_DIR = join(REPO_ROOT, "tmp", "dump");
export const POT_PATH = join(REPO_ROOT, "po", "template.pot");
export const REPORT_POT_PATH = join(REPO_ROOT, "tmp", "potgen", "template.pot");

/** TMP-теги шрифта/материала: не входят в шаблон (выбор рендерера). */
const FONT_TAG_RX = /<\/?(?:font|material)[^>]*>/gi;

/** Вырезать `<font>`/`<material>` (остальные теги остаются). */
export function stripFontTags(s: string): string {
  return s ? s.replace(FONT_TAG_RX, "") : s;
}

/** Дата в формате Python `strftime("%Y-%m-%d %H:%M+0000")` (UTC). */
export function formatPotDate(d: Date = new Date()): string {
  const p = (n: number): string => String(n).padStart(2, "0");
  return (
    `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ` +
    `${p(d.getUTCHours())}:${p(d.getUTCMinutes())}+0000`
  );
}

/** Строки заголовка POT (перед записями; пустую строку добавит renderPo). */
export function potHeaderLines(created: string): string[] {
  return [
    // «potgen.py» оставлено намеренно: шапка входит в байт-паритет с прежним
    // POT. Смена строки = шум в диффе перевода без функциональной пользы.
    "# NeonTranslator EN template (generated by potgen.py — do not edit).",
    "# Translate by copying to ru.po / de.po and filling msgstr.",
    'msgid ""',
    'msgstr ""',
    '"Project-Id-Version: NeonTranslator 1.0\\n"',
    `"POT-Creation-Date: ${created}\\n"`,
    '"Content-Type: text/plain; charset=UTF-8\\n"',
    '"Content-Transfer-Encoding: 8bit\\n"',
  ];
}

/** msgctxt записи: имя персонажа / речь персонажа / обычный UI-текст. */
export function ctxtOf(item: InventoryItem): string {
  if (item.kind === "spk") return "speaker-name";
  if (item.speaker) return `speaker:${item.speaker}`;
  return "ui";
}

/**
 * Почему свежая строка не нуждается в переводе ("" = переводимая).
 *
 * Зеркало правила extractor.py: авто-триаж применяется только к raw/settings
 * (UI-ish), никогда к диалогам — в истории может встретиться что угодно.
 * В POT флаг не пишется: это только статистика (агент решает сам).
 */
export function triageReason(text: string, kind: ItemKind): string {
  if (kind === "dlg" || kind === "bundle" || kind === "spk") return "";
  if (isAssetName(text)) return "asset-name";
  if (isGarbageFragment(text)) return "binary-garbage";
  return "";
}

export interface PotSlot {
  comments: string[];
}

export interface PotStats {
  scanned: number;
  new: number;
  vanished: number;
  triaged: number;
  rich: number;
  mergedTwins: number;
}

export interface PotCatalog {
  /** msgid → msgctxt → запись каталога. */
  catalog: Map<string, Map<string, PotSlot>>;
  stats: PotStats;
}

function catalogKey(text: string, ctxt: string): string {
  return JSON.stringify([text, ctxt]);
}

function slotOf(catalog: Map<string, Map<string, PotSlot>>, text: string, ctxt: string): PotSlot {
  let byCtxt = catalog.get(text);
  if (!byCtxt) {
    byCtxt = new Map();
    catalog.set(text, byCtxt);
  }
  let slot = byCtxt.get(ctxt);
  if (!slot) {
    slot = { comments: [] };
    byCtxt.set(ctxt, slot);
  }
  return slot;
}

/**
 * Собрать каталог из инвентаря (аналог `build_pot_update`).
 *
 * `oldKeys` — пары (msgid, msgctxt) из прежнего POT: нужны только для
 * статистики new/vanished, на содержимое не влияют.
 */
export function buildCatalog(
  items: InventoryItem[],
  oldKeys: ReadonlySet<string> = new Set(),
): PotCatalog {
  const catalog = new Map<string, Map<string, PotSlot>>();
  const seen = new Set<string>();
  const stats: PotStats = {
    scanned: 0,
    new: 0,
    vanished: 0,
    triaged: 0,
    rich: 0,
    mergedTwins: 0,
  };

  for (const item of items) {
    stats.scanned += 1;
    const ctxt = ctxtOf(item);

    let rich = pyStrip(stripFontTags(item.richText ?? ""));
    if (rich === item.text) rich = ""; // форматирования нет, просто копия текста

    const key = catalogKey(item.text, ctxt);
    if (seen.has(key)) {
      // Двойник: один перевод на все вхождения. rich обновляем, только если
      // у первого вхождения его не было (стиль не зависит от порядка дампа).
      if (rich) {
        const slot = slotOf(catalog, item.text, ctxt);
        if (!slot.comments.some((c) => c.startsWith("rich_text:"))) {
          slot.comments.push(`rich_text: ${rich}`);
          stats.rich += 1;
        }
      }
      continue;
    }
    seen.add(key);

    const slot = slotOf(catalog, item.text, ctxt);
    if (rich) {
      const comment = `rich_text: ${rich}`;
      if (!slot.comments.includes(comment)) {
        slot.comments.push(comment);
        stats.rich += 1;
      }
    }
    if (!oldKeys.has(key)) stats.new += 1;
    if (triageReason(item.text, item.kind)) stats.triaged += 1;
  }

  // Cross-source dedup: ui-двойник диалоговой/спикерской строки удаляем —
  // рантайм ищет по голому тексту, иначе один текст переводится дважды.
  const nonUiTexts = new Set<string>();
  for (const [text, byCtxt] of catalog) {
    for (const ctxt of byCtxt.keys()) {
      if (ctxt !== "ui") {
        nonUiTexts.add(text);
        break;
      }
    }
  }
  for (const [text, byCtxt] of catalog) {
    if (byCtxt.has("ui") && nonUiTexts.has(text)) {
      byCtxt.delete("ui");
      stats.mergedTwins += 1;
      if (byCtxt.size === 0) catalog.delete(text);
    }
  }

  // vanished считаем по ранее виденным ключам (на содержимое не влияет).
  for (const key of oldKeys) {
    if (!seen.has(key)) stats.vanished += 1;
  }

  return { catalog, stats };
}

/** Число записей каталога (msgid × msgctxt). */
export function catalogSize(catalog: Map<string, Map<string, PotSlot>>): number {
  let n = 0;
  for (const byCtxt of catalog.values()) n += byCtxt.size;
  return n;
}

/** Отрендерить каталог в POT (сортировка по msgid, затем msgctxt). */
export function renderPot(
  catalog: Map<string, Map<string, PotSlot>>,
  created: string = formatPotDate(),
): string {
  const keys: Array<[string, string]> = [];
  for (const [text, byCtxt] of catalog) {
    for (const ctxt of byCtxt.keys()) keys.push([text, ctxt]);
  }
  keys.sort((a, b) => compareCodePoints(a[0], b[0]) || compareCodePoints(a[1], b[1]));

  const entries: PoEntry[] = keys.map(([text, ctxt]) => {
    const slot = (catalog.get(text) as Map<string, PotSlot>).get(ctxt) as PotSlot;
    const e = newEntry();
    e.msgctxt = ctxt;
    e.msgid = text;
    e.msgstr = "";
    e.comments = [...slot.comments];
    return e;
  });

  return renderPo(entries, potHeaderLines(created));
}

/** Ключи (msgid, msgctxt) существующего POT — для статистики. */
export function oldKeysFromPot(path: string = POT_PATH): Set<string> {
  const keys = new Set<string>();
  if (!existsSync(path)) return keys;
  for (const e of parsePo(readFileSync(path, "utf8"))) {
    if (e.msgid) keys.add(catalogKey(e.msgid, e.msgctxt));
  }
  return keys;
}

/** Атомарная запись: `.part` → rename (обрыв не обнуляет файл). */
export function writeAtomic(path: string, text: string): void {
  mkdirSync(dirname(path), { recursive: true });
  const part = `${path}.part`;
  try {
    writeFileSync(part, text, "utf8");
    renameSync(part, path);
  } catch (err) {
    rmSync(part, { force: true });
    throw err;
  }
}

export interface PotgenOptions {
  dumpDir?: string;
  outPath?: string;
  update?: boolean;
  /** Фиксированная дата заголовка (тесты/паритет); по умолчанию — сейчас. */
  created?: string;
}

export interface PotgenResult {
  outPath: string;
  entries: number;
  stats: PotStats;
  dumpDir: string;
}

/**
 * Полный прогон: дамп → инвентарь → каталог → POT.
 *
 * Без `outPath` и без `update` пишет в `tmp/potgen/template.pot`;
 * `update: true` — в `po/template.pot`.
 */
export async function runPotgen(options: PotgenOptions = {}): Promise<PotgenResult> {
  const dumpDir = options.dumpDir ?? DEFAULT_DUMP_DIR;
  const inventory = await scanDump(dumpDir);
  if (!inventory.items.length) {
    throw new Error(`empty dump: ${dumpDir} — переводимых строк не найдено`);
  }

  // Ключи берём из репозиторного `po/template.pot` ВСЕГДА, даже если пишем
  // в `--out` другой файл: это только статистика new/vanished, на состав
  // каталога не влияет.
  const { catalog, stats } = buildCatalog(inventory.items, oldKeysFromPot());
  if (catalogSize(catalog) === 0) {
    throw new Error("empty catalog: нечего записывать (пустой дамп?)");
  }

  const outPath = options.outPath ?? (options.update ? POT_PATH : REPORT_POT_PATH);
  writeAtomic(outPath, renderPot(catalog, options.created));

  return { outPath, entries: catalogSize(catalog), stats, dumpDir };
}

const USAGE = `Usage: node potgen.mts [--update] [--dump <dir>] [--out <path>]

  --update        записать po/template.pot (без флага — только tmp/potgen/)
  --dump <dir>    каталог JSONL-дампа (по умолчанию tmp/dump)
  --out <path>    явный путь результата (перебивает --update)
  -h, --help      эта справка`;

interface Cli {
  update: boolean;
  dumpDir?: string;
  outPath?: string;
  help: boolean;
}

function parseArgs(argv: string[]): Cli {
  const cli: Cli = { update: false, help: false };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "--update") cli.update = true;
    else if (arg === "--help" || arg === "-h") cli.help = true;
    else if (arg === "--dump" || arg === "--out") {
      const value = argv[i + 1];
      if (!value) throw new Error(`${arg} требует путь`);
      i += 1;
      if (arg === "--dump") cli.dumpDir = value;
      else cli.outPath = value;
    } else if (arg.startsWith("--dump=")) cli.dumpDir = arg.slice("--dump=".length);
    else if (arg.startsWith("--out=")) cli.outPath = arg.slice("--out=".length);
    else throw new Error(`неизвестный аргумент: ${arg}`);
  }
  return cli;
}

/** CLI: 0 — успех, 1 — ошибка обработки, 2 — ошибка аргументов/дампа. */
export async function main(argv: string[]): Promise<number> {
  let cli: Cli;
  try {
    cli = parseArgs(argv);
  } catch (err) {
    console.error(`ERROR: ${(err as Error).message}\n\n${USAGE}`);
    return 2;
  }
  if (cli.help) {
    console.error(USAGE);
    return 0;
  }

  try {
    const res = await runPotgen(cli);
    const mode = cli.update ? "update" : "dry";
    console.error(`POT(${mode}): ${res.entries} entries -> ${res.outPath}`);
    const s = res.stats;
    console.error(
      `  inventory items: ${s.scanned}, new: ${s.new}, vanished: ${s.vanished}, ` +
        `triaged(classifier only): ${s.triaged}, rich: ${s.rich}, merged twins: ${s.mergedTwins}`,
    );
    return 0;
  } catch (err) {
    console.error(`ERROR: ${(err as Error).message}`);
    return 1;
  }
}

if (import.meta.filename === process.argv[1]) {
  process.exitCode = await main(process.argv.slice(2));
}
