/** Журнал помеченных `#, skip` записей (симметрично `pot-excluded.jsonl`). */
export const SKIP_JOURNAL_PATH = join(REPO_ROOT, "tmp", "pot-skip.jsonl");

/** TMP-теги шрифта/материала: не входят в шаблон (выбор рендерера). */
const FONT_TAG_RX = /<\/?(?:font|material)[^>]*>/gi;

/** Вырезать `<font>`/`<material>` (остальные теги остаются). */
export function stripFontTags(s: string): string {
  return s ? s.replace(FONT_TAG_RX, "") : s;
}

/** Дата в формате Python `strftime("%Y-%m-%d %H:%M+0000")` (UTC). */
export function formatPotDate(d: Date = new Date()): string {
  const p = (n: number): string => String(n).padStart(2, "0");
  return (
    `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ` +
    `${p(d.getUTCHours())}:${p(d.getUTCMinutes())}+0000`
  );
}

/** Строки заголовка POT (перед записями; пустую строку добавит renderPo). */
export function potHeaderLines(created: string): string[] {
  return [
    // «potgen.py» оставлено намеренно: шапка входит в байт-паритет с прежним
    // POT. Смена строки = шум в диффе перевода без функциональной пользы.
    "# NeonTranslator EN template (generated by potgen.py — do not edit).",
    "# Translate by copying to ru.po / de.po and filling msgstr.",
    'msgid ""',
    'msgstr ""',
    '"Project-Id-Version: NeonTranslator 1.0\\n"',
    `"POT-Creation-Date: ${created}\\n"`,
    '"Content-Type: text/plain; charset=UTF-8\\n"',
    '"Content-Transfer-Encoding: 8bit\\n"',
  ];
}

/** msgctxt записи: имя персонажа / речь персонажа / обычный UI-текст. */
export function ctxtOf(item: InventoryItem): string {
  if (item.kind === "spk") return "speaker-name";
  if (item.speaker) return `speaker:${item.speaker}`;
  return "ui";
}

/**
 * Почему свежая строка не нуждается в переводе ("" = переводимая).
 *
 * Зеркало правила extractor.py: авто-триаж применяется только к raw/settings
 * (UI-ish), никогда к диалогам — в истории может встретиться что угодно.
 * В POT флаг не пишется: это только статистика (агент решает сам).
 */
export function triageReason(text: string, kind: ItemKind): string {
  if (kind === "dlg" || kind === "bundle" || kind === "spk") return "";
  if (isAssetName(text)) return "asset-name";
  if (isGarbageFragment(text)) return "binary-garbage";
  return "";
}

// ---------------------------------------------------------------------------
// Политика отбора по провенансу (`config/pot-src-policy.json`).
//
// Политика — ДАННЫЕ, а не код: `exclude` перечисляет метки `#. src:`, которые
// не попадают в POT; `include` — что вообще допускается (`*` = всё). Шаблон
// метки — точная метка или префикс с `*` (`raw:Font`, `raw:Tex*`, `raw:*`).
// Исключённые записи не теряются: `tmp/pot-excluded.jsonl`.
// ---------------------------------------------------------------------------

/** Метки без параметра (контракт `#. src:`, инвариант 14). */
const FIXED_SRC_LABELS: readonly string[] = ["dialog", "bundle", "settings", "us", "global"];

/**
 * Классы Unity, которыми дамп помечает объект (`type` → `raw:<Class>`).
