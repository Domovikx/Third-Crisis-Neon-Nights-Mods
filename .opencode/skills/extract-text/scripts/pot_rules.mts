/** C#-идентификатор: та же грамматика, что у `isValidSrc` в inventory. */
const CS_ID_RX = /^[A-Za-z_][A-Za-z0-9_]*$/;
/** `ClassID<digits>` — имя класса, которого нет в таблице дампа. */
const CLASS_ID_RX = /^ClassID\d+$/;

/** Политика отбора: шаблоны `exclude`/`include` + путь, откуда прочитана. */
export interface SrcPolicy {
  path: string;
  exclude: string[];
  include: string[];
}

/** Почему запись не попала в POT (или "" — попала). */
export interface PolicyDecision {
  excluded: boolean;
  reason: string;
}

/** Запись, выброшенная политикой: ровно строка журнала `tmp/pot-excluded.jsonl`. */
export interface ExcludedEntry {
  src: string;
  msgid: string;
  msgctxt: string;
  reason: string;
}

/** Итог политики для отчёта прогона. */
export interface PolicyReport {
  path: string;
  excluded: number;
  kept: number;
  /** Сколько исключено по каждой метке (по убыванию, затем по метке). */
  bySrc: Array<{ src: string; count: number }>;
}

/** Проверить шаблон метки; `null` — валиден, иначе текст ошибки. */
export function validatePolicyPattern(pattern: string): string | null {
  if (!pattern) return 'пустая метка (шаблон не может быть "")';

  if (pattern === "*") return null;
  const prefix = pattern.endsWith("*");
  const label = prefix ? pattern.slice(0, -1) : pattern;
  if (!label) return `неизвестная метка "${pattern}"`;

  if (FIXED_SRC_LABELS.includes(label)) return null;
  if (prefix && FIXED_SRC_LABELS.some((x) => x.startsWith(label))) return null;

  if (label === "raw:" || label === "field:") {
    // `raw:*` / `field:*` — «все raw-классы» / «все типизированные поля».
    return prefix ? null : `неизвестная метка "${pattern}" (нужен шаблон "${label}*")`;
  }

  if (label.startsWith("raw:")) {
    const name = label.slice("raw:".length);
    if (!CS_ID_RX.test(name) && !CLASS_ID_RX.test(name)) {
      return `неизвестная метка "${pattern}": ожидается raw:<Класс> или raw:<Класс>*`;
    }
    if (prefix) {
      const ok = KNOWN_RAW_CLASSES.some((x) => x.startsWith(name)) || name.startsWith("ClassID");
      return ok ? null : `неизвестная метка "${pattern}": нет класса с префиксом "${name}"`;
    }
    if (KNOWN_RAW_CLASSES.includes(name) || CLASS_ID_RX.test(name)) return null;
    return `неизвестная метка "${pattern}": класс "${name}" не встречается в дампе`;
  }

  if (label.startsWith("field:")) {
    const name = label.slice("field:".length);
    if (CS_ID_RX.test(name)) return null;
    return `неизвестная метка "${pattern}": ожидается field:<ИмяПоля> ([A-Za-z_][A-Za-z0-9_]*)`;
  }

  return `неизвестная метка "${pattern}" (допустимо: dialog, bundle, settings, us, global, field:<Поле>, raw:<Класс>, «*»)`;
}

function readPolicyPatterns(value: unknown, field: string, source: string): string[] {
  if (!Array.isArray(value)) {
    throw new Error(`политика ${source}: поле "${field}" должно быть массивом строк`);
  }
  const out: string[] = [];
  for (const raw of value) {
    if (typeof raw !== "string") {
      throw new Error(`политика ${source}: в "${field}" не строка: ${JSON.stringify(raw)}`);
    }
    const err = validatePolicyPattern(raw);
    if (err) throw new Error(`политика ${source}: ${err}`);
    out.push(raw);
  }
  return out;
}

/** Разобрать политику (JSON-текст) с понятными ошибками. */
export function parseSrcPolicy(text: string, source = "<policy>"): SrcPolicy {
  let value: unknown;
  try {
    value = JSON.parse(text);
  } catch (err) {
    throw new Error(`невалидный JSON политики ${source}: ${(err as Error).message}`);
  }
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    throw new Error(`политика ${source}: ожидался объект {"exclude": [...], "include": [...]}`);
  }
  const obj = value as Record<string, unknown>;
  for (const key of Object.keys(obj)) {
    // `_`-поля — комментарии данных (их не исполняем, но и не ругаемся).
    if (key !== "exclude" && key !== "include" && !key.startsWith("_")) {
      throw new Error(
        `политика ${source}: неизвестное поле "${key}" (допустимы exclude, include и _комментарии)`,
      );
    }
  }
  const exclude =
    obj.exclude === undefined ? [] : readPolicyPatterns(obj.exclude, "exclude", source);
  const include =
    obj.include === undefined ? ["*"] : readPolicyPatterns(obj.include, "include", source);
  if (include.length === 0) {
    throw new Error(
      `политика ${source}: "include" пуст — POT вышел бы пустым (для «всё» укажите ["*"])`,
    );
  }
  return { path: source, exclude, include };
}

/** Прочитать политику с диска; `required` — отсутствие файла это ошибка. */
export function loadSrcPolicy(path: string, opts: { required?: boolean } = {}): SrcPolicy | null {
  let text: string;
  try {
    text = readFileSync(path, "utf8");
  } catch (err) {
    if (!opts.required && (err as NodeJS.ErrnoException).code === "ENOENT") return null;
    throw new Error(`политика не читается ${path}: ${(err as Error).message}`);
  }
  return parseSrcPolicy(text, path);
}

/** Найти `config/pot-src-policy.json` в `start` или выше (как .editorconfig). */
export function discoverPolicyPath(start: string = REPO_ROOT): string | null {
  let dir = resolve(start);
  for (;;) {
    const candidate = join(dir, "config", "pot-src-policy.json");
    if (existsSync(candidate)) return candidate;
    const parent = dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

/** Совпадает ли метка с шаблоном политики (точная метка или префикс `*`). */
export function srcMatchesPattern(pattern: string, src: string): boolean {
  if (pattern === "*") return true;
  if (pattern.endsWith("*")) return src.startsWith(pattern.slice(0, -1));
  return src === pattern;
}

/** Решение политики по одной метке: исключать или нет (и почему). */
export function policyDecision(policy: SrcPolicy, src: string): PolicyDecision {
  if (!policy.include.some((p) => srcMatchesPattern(p, src))) {
    return { excluded: true, reason: "not-included" };
  }
  const hit = policy.exclude.find((p) => srcMatchesPattern(p, src));
  if (hit) return { excluded: true, reason: `exclude:${hit}` };
  return { excluded: false, reason: "" };
}

/** Применить политику к каталогу: исключённые записи уходят в журнал. */
export function applySrcPolicy(
  catalog: Catalog,
  policy: SrcPolicy,
): { catalog: Catalog; excluded: ExcludedEntry[]; bySrc: PolicyReport["bySrc"] } {
  const kept: Catalog = new Map();
  const excluded: ExcludedEntry[] = [];
  const counts = new Map<string, number>();

  for (const [text, byCtxt] of catalog) {
    let keptCtxt: Map<string, PotSlot> | null = null;
    for (const [ctxt, slot] of byCtxt) {
      const decision = policyDecision(policy, slot.src);
      if (decision.excluded) {
        excluded.push({ src: slot.src, msgid: text, msgctxt: ctxt, reason: decision.reason });
        counts.set(slot.src, (counts.get(slot.src) ?? 0) + 1);
        continue;
      }
      keptCtxt ??= new Map();
      keptCtxt.set(ctxt, slot);
    }
    if (keptCtxt) kept.set(text, keptCtxt);
  }

  excluded.sort(
    (a, b) => compareCodePoints(a.msgid, b.msgid) || compareCodePoints(a.msgctxt, b.msgctxt),
  );
  const bySrc = [...counts.entries()]
    .map(([src, count]) => ({ src, count }))
    .sort((a, b) => b.count - a.count || compareCodePoints(a.src, b.src));
  return { catalog: kept, excluded, bySrc };
}

/** Журнал исключённых как JSONL (по строке на запись, порядок POT). */
export function renderExcludedJsonl(entries: readonly ExcludedEntry[]): string {
  if (entries.length === 0) return "";
  return (
    entries
      .map((e) =>
        JSON.stringify({ src: e.src, msgid: e.msgid, msgctxt: e.msgctxt, reason: e.reason }),
      )
      .join("\n") + "\n"
  );
}

// ---------------------------------------------------------------------------
// Skip-политика («этой строке перевод не нужен»).
//
// Политика — ДАННЫЕ (`config/pot-skip-policy.mts`; JSON — артефакт): правило = `id` + метка
// `src` (та же грамматика, что у политики отбора) + условие `when` из
// `pot_skip.mts`. Неизвестное условие/метка — ошибка, а не тихий игнор.
// Записи НЕ удаляются: POT получает `#, skip` и `#. skip: <id>`.
// ---------------------------------------------------------------------------

/** Правило skip-политики. */
export interface SkipRule {
  /** Идентификатор правила — он и попадает в POT (`#. skip: <id>`). */
  id: string;
  /** Шаблон метки `#. src:` (точная метка или префикс `*`). */
  src: string;
  /**
   * Метки, которые правило НЕ трогает, даже если они совпали с `src`
   * (та же грамматика). Нужно, чтобы сузить правило по данным: например,
   * `shortToken` для всего `raw:*`, кроме `raw:MonoBehaviour`, где лежат
   * настоящие подписи (`ACCESS`, `ACHIEVEMENTS`).
   */
  srcExclude: string[];
  /** Условие из `pot_skip.mts`. */
  when: SkipCondition;
  /** `false` — правило остаётся в политике для ревью, но не действует. */
  enabled: boolean;
}

/** Разобранная skip-политика + путь, откуда прочитана. */
export interface SkipPolicy {
  path: string;
  rules: SkipRule[];
}

/** Строка журнала `tmp/pot-skip.jsonl` — ровно одна помеченная запись. */
export interface SkipJournalEntry {
  rule: string;
  src: string;
  msgid: string;
  msgctxt: string;
}

/** Итог skip-политики для отчёта прогона. */
export interface SkipReport {
  path: string;
  marked: number;
  /** Сколько помечено каждым правилом (порядок политики). */
  byRule: Array<{ rule: string; count: number }>;
}

const RULE_ID_RX = /^[a-z0-9][a-z0-9-]*$/;

/** Разобрать skip-политику (JSON-текст) с понятными ошибками. */
export function parseSkipPolicy(text: string, source = "<skip-policy>"): SkipPolicy {
  let value: unknown;
  try {
    value = JSON.parse(text);
  } catch (err) {
    throw new Error(`невалидный JSON skip-политики ${source}: ${(err as Error).message}`);
  }
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    throw new Error(`skip-политика ${source}: ожидался объект {"rules": [...]}`);
  }
  const obj = value as Record<string, unknown>;
  for (const key of Object.keys(obj)) {
    if (key !== "rules" && !key.startsWith("_")) {
      throw new Error(
        `skip-политика ${source}: неизвестное поле "${key}" (допустимы rules и _комментарии)`,
      );
    }
  }
  if (!Array.isArray(obj.rules)) {
    throw new Error(`skip-политика ${source}: поле "rules" должно быть массивом правил`);
  }

  const rules: SkipRule[] = [];
  const seen = new Set<string>();
  obj.rules.forEach((raw, index) => {
    if (!raw || typeof raw !== "object" || Array.isArray(raw)) {
      throw new Error(`skip-политика ${source}: правило #${index + 1} — не объект`);
    }
    const rule = raw as Record<string, unknown>;
    for (const key of Object.keys(rule)) {
      if (
        key !== "id" &&
        key !== "src" &&
        key !== "srcExclude" &&
        key !== "when" &&
        key !== "enabled"
      ) {
        throw new Error(
          `skip-политика ${source}: правило #${index + 1} — неизвестное поле "${key}"`,
        );
      }
    }
    const id = rule.id;
    if (typeof id !== "string" || !RULE_ID_RX.test(id)) {
      throw new Error(
        `skip-политика ${source}: правило #${index + 1} — id обязателен ("${String(id)}", ожидается [a-z0-9-])`,
      );
    }
    if (seen.has(id)) {
      throw new Error(`skip-политика ${source}: id правила повторяется: "${id}"`);
    }
    seen.add(id);
    const src = rule.src;
    if (typeof src !== "string") {
      throw new Error(`skip-политика ${source}: правило "${id}" — src обязателен`);
    }
    const srcError = validatePolicyPattern(src);
    if (srcError) throw new Error(`skip-политика ${source}: правило "${id}" — ${srcError}`);
    const srcExclude: string[] = [];
    if (rule.srcExclude !== undefined) {
      if (!Array.isArray(rule.srcExclude)) {
        throw new Error(
          `skip-политика ${source}: правило "${id}" — srcExclude должен быть массивом меток`,
        );
      }
      for (const pattern of rule.srcExclude) {
        if (typeof pattern !== "string") {
          throw new Error(
            `skip-политика ${source}: правило "${id}" — srcExclude: ожидалась строка, ` +
              `получено ${typeof pattern}`,
          );
        }
        const patternError = validatePolicyPattern(pattern);
        if (patternError) {
          throw new Error(`skip-политика ${source}: правило "${id}" — srcExclude: ${patternError}`);
        }
        srcExclude.push(pattern);
      }
    }
    const when = rule.when;
    if (typeof when !== "string" || !SKIP_CONDITIONS.includes(when as SkipCondition)) {
      throw new Error(
        `skip-политика ${source}: правило "${id}" — неизвестное условие "${String(when)}" ` +
          `(допустимо: ${SKIP_CONDITIONS.join(", ")})`,
      );
    }
    if (rule.enabled !== undefined && typeof rule.enabled !== "boolean") {
      throw new Error(`skip-политика ${source}: правило "${id}" — enabled должен быть boolean`);
    }
    rules.push({
      id,
      src,
      srcExclude,
      when: when as SkipCondition,
      enabled: rule.enabled !== false,
    });
  });

  return { path: source, rules };
}

/** Прочитать skip-политику с диска; `required` — отсутствие файла это ошибка. */
export function loadSkipPolicy(path: string, opts: { required?: boolean } = {}): SkipPolicy | null {
  let text: string;
  try {
    text = readFileSync(path, "utf8");
  } catch (err) {
    if (!opts.required && (err as NodeJS.ErrnoException).code === "ENOENT") return null;
    throw new Error(`skip-политика не читается ${path}: ${(err as Error).message}`);
  }
  return parseSkipPolicy(text, path);
}

/** Найти `config/pot-skip-policy.json` в `start` или выше (как политика отбора). */
export function discoverSkipPolicyPath(start: string = REPO_ROOT): string | null {
  let dir = resolve(start);
  for (;;) {
    const candidate = join(dir, "config", "pot-skip-policy.json");
    if (existsSync(candidate)) return candidate;
    const parent = dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

export interface PotSlot {
  /** Провенанс записи: `dialog`/`bundle`/`field:*`/`settings`/`us`/`raw:*`/`global`. */
  src: string;
  comments: string[];
  /**
   * Id правила skip-политики, если перевод не нужен: в POT даёт `#, skip` и
   * `#. skip: <id>`. Запись при этом остаётся в POT (прозрачность).
   */
  skip?: string;
}

/** Каталог: msgid → msgctxt → слот. */
export type Catalog = Map<string, Map<string, PotSlot>>;

export interface PotStats {
  scanned: number;
  new: number;
  vanished: number;
  triaged: number;
  rich: number;
  mergedTwins: number;
}

export interface PotCatalog {
  /** msgid → msgctxt → запись каталога. */
  catalog: Catalog;
  stats: PotStats;
}

function catalogKey(text: string, ctxt: string): string {
  return JSON.stringify([text, ctxt]);
}

function slotOf(catalog: Catalog, text: string, ctxt: string): PotSlot {
  let byCtxt = catalog.get(text);
  if (!byCtxt) {
    byCtxt = new Map();
    catalog.set(text, byCtxt);
  }
  let slot = byCtxt.get(ctxt);
  if (!slot) {
    slot = { src: "", comments: [] };
    byCtxt.set(ctxt, slot);
  }
  return slot;
}

/**
 * Собрать каталог из инвентаря (аналог `build_pot_update`).
 *
 * `oldKeys` — пары (msgid, msgctxt) из прежнего POT: нужны только для
 * статистики new/vanished, на содержимое не влияют.
 */
/**
 * Починить «фрагмент»: игра (AN) получила `text` наивной чисткой `<[^>]+>`,
 * поэтому авторские кавычки `< … >` съедаются вместе с началом фразы, а в
 * `text` остаётся хвост. Полная фраза при этом жива в `rich_text`.
 *
 * Возвращаем полный текст, если `text` — его строгий хвост и перед ним есть
 * буквы. Ключом становится полная фраза: тогда перевод полный, а рантайм
 * (`richText.Replace(plain, translation)`) собирает строку целиком.
 */
export function repairFragment(
  text: string,
  richPlain: string,
): { text: string; original: string } | null {
  const full = richPlain.trim();
  if (!full || !text || full === text || !full.endsWith(text)) return null;
  // Чиним только осмысленный хвост: одиночный «>» — шум разметки, а не фраза
  // (порог тот же, что у инварианта `rich-fragment`).
  if (!isMeaningfulText(text)) return null;
  const prefix = full.slice(0, full.length - text.length);
  if (!/\p{L}/u.test(prefix)) return null;
  return { text: full, original: text };
}

/**
 * Ключ записи с учётом починки фрагмента: если `text` — хвост полной фразы из
 * `rich_text`, ключом становится полная фраза. Одна функция на генератор и на
 * чекер контракта: иначе «полнота» сверяла бы POT с обрезанными ключами.
 */
export function repairItemText(text: string, richText: string): string {
  if (!richText) return text;
  const rich = pyStrip(stripFontTags(richText));
  if (!rich) return text;
  const fix = repairFragment(text, pyStrip(stripTmpTags(rich)));
  return fix ? fix.text : text;
}

export function buildCatalog(
  items: InventoryItem[],
  oldKeys: ReadonlySet<string> = new Set(),
  /**
   * Признак «эта метка исключена политикой». Нужен при дедупе: если строку
   * доставили и ассет (`raw:GameObject`), и живой источник (`dialog`),
   * победить обязан живой — иначе срез ассетов унесёт настоящий текст.
   * Проверка политики ПОСЛЕ дедупа этого не спасает (слот уже один).
   */
  isExcluded?: (src: string) => boolean,
): PotCatalog {
  const catalog: Catalog = new Map();
  const seen = new Set<string>();
  const stats: PotStats = {
    scanned: 0,
    new: 0,
    vanished: 0,
    triaged: 0,
    rich: 0,
    mergedTwins: 0,
  };

  for (const item of items) {
    stats.scanned += 1;
    const ctxt = ctxtOf(item);

    let rich = pyStrip(stripFontTags(item.richText ?? ""));

    // Фрагмент из данных игры: `text` — хвост полной фразы из `rich_text`.
    // Ключом делаем полную фразу, исходный хвост сохраняем комментарием.
    let text = item.text;
    let repairedFrom = "";
    if (rich) {
      const fix = repairFragment(text, pyStrip(stripTmpTags(rich)));
      if (fix) {
        text = fix.text;
        repairedFrom = fix.original;
      }
    }
    if (rich === text) rich = ""; // форматирования нет, просто копия текста

    const key = catalogKey(text, ctxt);
    if (seen.has(key)) {
      // Двойник: один перевод на все вхождения. rich обновляем, только если
      // у первого вхождения его не было (стиль не зависит от порядка дампа).
      //
      // Если слот занял исключённый источник, а сейчас пришёл живой —
      // переключаем метку на живой: иначе строка выпадет вместе с ассетом.
      if (isExcluded) {
        const slot = slotOf(catalog, text, ctxt);
        if (slot.src && isExcluded(slot.src) && !isExcluded(item.src)) {
          slot.src = item.src;
        }
      }
      if (rich) {
        const slot = slotOf(catalog, text, ctxt);
        if (!slot.comments.some((c) => c.startsWith("rich_text:"))) {
          slot.comments.push(`rich_text: ${rich}`);
          stats.rich += 1;
        }
      }
      continue;
    }
    seen.add(key);

    const slot = slotOf(catalog, text, ctxt);
    // src — первого вхождения: при дедупе это и есть путь доставки строки
    // в POT (как правило «первое вхождение побеждает» у rich_text).
    if (!slot.src) slot.src = item.src;
    if (rich) {
      const comment = `rich_text: ${rich}`;
      if (!slot.comments.includes(comment)) {
        slot.comments.push(comment);
        stats.rich += 1;
      }
    }
    if (repairedFrom && !slot.comments.some((c) => c.startsWith("repaired: "))) {
      slot.comments.push(`repaired: ${repairedFrom}`);
    }
    if (!oldKeys.has(key)) stats.new += 1;
    if (triageReason(text, item.kind)) stats.triaged += 1;
  }

  // Cross-source dedup: ui-двойник диалоговой/спикерской строки удаляем —
  // рантайм ищет по голому тексту, иначе один текст переводится дважды.
  const nonUiTexts = new Set<string>();
  for (const [text, byCtxt] of catalog) {
    for (const ctxt of byCtxt.keys()) {
      if (ctxt !== "ui") {
        nonUiTexts.add(text);
        break;
      }
    }
  }
  for (const [text, byCtxt] of catalog) {
    if (byCtxt.has("ui") && nonUiTexts.has(text)) {
      byCtxt.delete("ui");
      stats.mergedTwins += 1;
      if (byCtxt.size === 0) catalog.delete(text);
    }
  }

  // vanished считаем по ранее виденным ключам (на содержимое не влияет).
  for (const key of oldKeys) {
    if (!seen.has(key)) stats.vanished += 1;
  }

  return { catalog, stats };
}

/** Число записей каталога (msgid × msgctxt). */
export function catalogSize(catalog: Catalog): number {
  let n = 0;
  for (const byCtxt of catalog.values()) n += byCtxt.size;
  return n;
}

/**
 * Применить skip-политику к каталогу: пометить записи, собрать журнал.
 *
 * Побеждает ПЕРВОЕ подходящее правило в порядке политики (порядок — данные,
 * поэтому результат детерминирован). Записи не удаляются и не меняются —
 * только получают метку правила.
 */
export function applySkipPolicy(
  catalog: Catalog,
  policy: SkipPolicy,
): { marked: number; journal: SkipJournalEntry[]; byRule: SkipReport["byRule"] } {
  const keys: Array<[string, string]> = [];
  for (const [text, byCtxt] of catalog) {
    for (const ctxt of byCtxt.keys()) keys.push([text, ctxt]);
  }
  keys.sort((a, b) => compareCodePoints(a[0], b[0]) || compareCodePoints(a[1], b[1]));

  const active = policy.rules.filter((r) => r.enabled);
  const counts = new Map<string, number>(active.map((r) => [r.id, 0]));
  const journal: SkipJournalEntry[] = [];

  for (const [text, ctxt] of keys) {
    const slot = (catalog.get(text) as Map<string, PotSlot>).get(ctxt) as PotSlot;
    const rich =
      slot.comments.find((c) => c.startsWith("rich_text: "))?.slice("rich_text: ".length) ?? "";
    const rule = active.find(
      (r) =>
        srcMatchesPattern(r.src, slot.src) &&
        !r.srcExclude.some((pattern) => srcMatchesPattern(pattern, slot.src)) &&
        skipConditionMatches(r.when, { msgid: text, rich }),
    );
    if (!rule) continue;
    slot.skip = rule.id;
    counts.set(rule.id, (counts.get(rule.id) ?? 0) + 1);
    journal.push({ rule: rule.id, src: slot.src, msgid: text, msgctxt: ctxt });
  }

  return {
    marked: journal.length,
    journal,
    byRule: active.map((r) => ({ rule: r.id, count: counts.get(r.id) ?? 0 })),
  };
}

/** Путь к подтверждённым точечным skip-решениям (данные, не код). */
export const SKIP_IDS_PATH = join(REPO_ROOT, "config", "pot-skip-ids.json");
/** id правила для записей из списка `config/pot-skip-ids.json`. */
export const REVIEWED_RULE_ID = "reviewed";

/**
 * Разобрать `config/pot-skip-ids.json`: `{"skip": ["msgid", …]}`.
 *
 * Это данные, подтверждённые человеком (например, вердикты LLM-классификатора
 * `pot_llm_skip.mts`). Неизвестные поля — ошибка, а не тихий игнор: опечатка в
 * ключе иначе выглядела бы как «список не применился».
 */
export function parseSkipIds(text: string, source = "<skip-ids>"): Set<string> {
  let value: unknown;
  try {
    value = JSON.parse(text);
  } catch (err) {
    throw new Error(`невалидный JSON списка skip-id ${source}: ${(err as Error).message}`);
  }
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    throw new Error(`список skip-id ${source}: ожидался объект {"skip": [...]}`);
  }
  const obj = value as Record<string, unknown>;
  for (const key of Object.keys(obj)) {
    if (key !== "skip" && !key.startsWith("_")) {
      throw new Error(`список skip-id ${source}: неизвестное поле "${key}"`);
    }
  }
  if (!Array.isArray(obj.skip)) {
    throw new Error(`список skip-id ${source}: поле "skip" должно быть массивом строк`);
  }
  const out = new Set<string>();
  for (const item of obj.skip) {
    if (typeof item !== "string" || !item) {
      throw new Error(
        `список skip-id ${source}: ожидалась непустая строка, получено ${typeof item}`,
      );
    }
    out.add(item);
  }
  return out;
}

/** Найти `config/pot-skip-ids.json` в `start` или выше (как у политик). */
export function discoverSkipIdsPath(start: string = REPO_ROOT): string | null {
  let dir = resolve(start);
  for (;;) {
    const candidate = join(dir, "config", "pot-skip-ids.json");
    if (existsSync(candidate)) return candidate;
    const parent = dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

/** Прочитать список skip-id с диска (нет файла — пустой список). */
export function loadSkipIds(path: string = SKIP_IDS_PATH): Set<string> | null {
  if (!existsSync(path)) return null;
  return parseSkipIds(readFileSync(path, "utf8"), path);
}

/**
 * Пометить записи из подтверждённого списка. Уже помеченные структурным
 * правилом сохраняют свою причину (она точнее), счётчик считает только новые.
 */
export function applySkipIds(
  catalog: Catalog,
  ids: ReadonlySet<string>,
): { marked: number; unused: number; journal: SkipJournalEntry[] } {
  let marked = 0;
  const used = new Set<string>();
  const journal: SkipJournalEntry[] = [];
  for (const [text, byCtxt] of catalog) {
    if (!ids.has(text)) continue;
    used.add(text);
    for (const [ctxt, slot] of byCtxt) {
      if (slot.skip) continue;
      slot.skip = REVIEWED_RULE_ID;
      marked += 1;
      journal.push({ rule: REVIEWED_RULE_ID, src: slot.src, msgid: text, msgctxt: ctxt });
    }
  }
  return { marked, unused: ids.size - used.size, journal };
}

/** Журнал skip как JSONL (по строке на запись, порядок POT). */
export function renderSkipJournalJsonl(entries: readonly SkipJournalEntry[]): string {
  if (entries.length === 0) return "";
  return (
    entries
      .map((e) => JSON.stringify({ rule: e.rule, src: e.src, msgid: e.msgid, msgctxt: e.msgctxt }))
      .join("\n") + "\n"
  );
}

/** Отрендерить каталог в POT (сортировка по msgid, затем msgctxt). */
export function renderPot(
  catalog: Catalog,
  created: string = formatPotDate(),
  opts: { includeSrc?: boolean } = {},
): string {
  const includeSrc = opts.includeSrc !== false;
  const keys: Array<[string, string]> = [];
  for (const [text, byCtxt] of catalog) {
    for (const ctxt of byCtxt.keys()) keys.push([text, ctxt]);
  }
  keys.sort((a, b) => compareCodePoints(a[0], b[0]) || compareCodePoints(a[1], b[1]));

  const entries: PoEntry[] = keys.map(([text, ctxt]) => {
    const slot = (catalog.get(text) as Map<string, PotSlot>).get(ctxt) as PotSlot;
    const e = newEntry();
    e.msgctxt = ctxt;
    e.msgid = text;
    e.msgstr = "";
    // Провенанс — первым комментарием (рядом с rich_text): по нему строится
    // политика отбора, см. docs/pot-provenance.md. `includeSrc: false` нужен
    // только для сверки POT, сгенерированного ДО провенанса.
    // `skip: <id>` идёт сразу за src: причина «не переводить» видна до текста.
    e.comments = [
      ...(includeSrc && slot.src ? [`src: ${slot.src}`] : []),
      ...(slot.skip ? [`skip: ${slot.skip}`] : []),
      ...slot.comments,
    ];
    if (slot.skip) e.flags = ["skip"];
    return e;
  });

  return renderPo(entries, potHeaderLines(created));
}

/** Провенанс записей каталога: ключ `(msgid, msgctxt)` → метка `src`. */
export function srcOf(catalog: Catalog): Map<string, string> {
  const out = new Map<string, string>();
  for (const [text, byCtxt] of catalog) {
    for (const [ctxt, slot] of byCtxt) out.set(catalogKey(text, ctxt), slot.src);
  }
  return out;
}

/** Ключи (msgid, msgctxt) существующего POT — для статистики. */
export function oldKeysFromPot(path: string = POT_PATH): Set<string> {
  const keys = new Set<string>();
  if (!existsSync(path)) return keys;
  for (const e of parsePo(readFileSync(path, "utf8"))) {
    if (e.msgid) keys.add(catalogKey(e.msgid, e.msgctxt));
  }
  return keys;
}

/** Атомарная запись: `.part` → rename (обрыв не обнуляет файл). */
export function writeAtomic(path: string, text: string): void {
  mkdirSync(dirname(path), { recursive: true });
  const part = `${path}.part`;
  try {
    writeFileSync(part, text, "utf8");
    renameWithRetry(part, path);
  } catch (err) {
    rmSync(part, { force: true });
    throw err;
  }
}

/**
 * `rename` с повтором на Windows: сканер/индексатор на миг держит файл, и
 * `renameSync` отдаёт EPERM/EBUSY (проверено 2026-11-23: параллельные прогоны
 * `npm test` пишут общий `tmp/pot-excluded.jsonl`). Данные не меняются —
 * только ожидание 50 мс, максимум ~1 с.
 */
function renameWithRetry(from: string, to: string, attempts = 20): void {
  for (let attempt = 0; ; attempt += 1) {
    try {
      renameSync(from, to);
      return;
    } catch (err) {
      const code = (err as NodeJS.ErrnoException).code;
      if (attempt >= attempts || (code !== "EPERM" && code !== "EBUSY" && code !== "EACCES")) {
        throw err;
      }
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
    }
  }
}

/**
 * Запись журнала исключённых: временный файл с PID в имени.
 *
 * Отдельно от `writeAtomic`, потому что журнал пишут параллельные прогоны
 * (тесты) — общий `.part` они бы перемешали, а полный уникальный файл,
 * переименованный поверх, всегда валиден (побеждает последний писатель).
 */
export function writeExcludedAtomic(path: string, text: string): void {
  mkdirSync(dirname(path), { recursive: true });
  const part = `${path}.${process.pid}.part`;
  try {
    writeFileSync(part, text, "utf8");
    renameWithRetry(part, path);
  } catch (err) {
    rmSync(part, { force: true });
    throw err;
  }
}

/**
 * Запись журнала skip (`tmp/pot-skip.jsonl`).
 *
 * Тот же приём, что у журнала исключённых: уникальный `.part` с PID, потому
 * что журналы пишут параллельные прогоны (тесты), а полный файл,
 * переименованный поверх, всегда валиден (побеждает последний писатель).
 */
export function writeSkipJournalAtomic(path: string, entries: readonly SkipJournalEntry[]): void {
  writeExcludedAtomic(path, renderSkipJournalJsonl(entries));
}
